# Copy to .env on CT102 and fill in.

# --- Files ---------------------------------------------------------------
# The syncthing user's IDs, from `id syncthing` (setup-syncthing.sh prints them).
APP_UID=1000
APP_GID=1000
# Host folder that Syncthing shares into the vault.
OUTPUT_DIR=/srv/yt-transcripts
TRANSCRIPT_LANGUAGES=en
# Host folder for the app's database (schedules, history). Not synced; must NOT
# be inside OUTPUT_DIR.
DATA_DIR=/srv/yt-transcripts-data

# --- Web app -------------------------------------------------------------
# CT102's LAN IP, so the UI is reachable from your network but not published
# on every interface. 127.0.0.1 = only from CT102 itself.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000
# Browser login. Required.
APP_USERNAME=admin
APP_PASSWORD=
# Time zone for schedules and displayed times (IANA name).
APP_TIMEZONE=Europe/London

# --- Obsidian ------------------------------------------------------------
# For "open in Obsidian" links and the Claude routine prompt: the vault's
# name, and where OUTPUT_DIR appears inside it.
OBSIDIAN_VAULT_NAME=tokvault
VAULT_FOLDER=YouTube Transcripts
NOTE_TAGS=youtube,transcript

# --- YouTube Data API v3 (Search and Schedules only; pasted links work without it)
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=
