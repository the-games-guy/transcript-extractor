# Copy to .env on CT102 and fill in from `id syncthing`.
APP_UID=1000
APP_GID=1000
OUTPUT_DIR=/srv/yt-transcripts
TRANSCRIPT_LANGUAGES=en
# Web UI (docker compose up -d). It has no login: keep it on 127.0.0.1 and
# use an SSH tunnel, or set a LAN-only address. Never 0.0.0.0 on CT102.
UI_BIND=127.0.0.1
UI_PORT=8080
