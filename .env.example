# --- Where transcripts go ---
# Folder the app writes into. In Docker this is the /vault mount (leave as is).
VAULT_DIR=./vault
# Subfolder inside VAULT_DIR for transcript notes ("" = the root of VAULT_DIR).
NOTES_FOLDER=YouTube
# Your vault's name as Obsidian shows it; used for "open in Obsidian" links.
OBSIDIAN_VAULT_NAME=My Vault
# Tags added to every note
NOTE_TAGS=youtube,transcript
# Preferred transcript languages, in order
TRANSCRIPT_LANGUAGES=en

# --- YouTube Data API v3 (needed for Search and Schedules, not for pasted links) ---
# Create a key at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" for the project.
YOUTUBE_API_KEY=

# --- Web app ---
HOST=0.0.0.0
PORT=8000
# Protects the web UI with a browser login (username/password). Strongly
# recommended on a server.
APP_USERNAME=admin
APP_PASSWORD=
# Time zone for schedules and displayed times (IANA name, e.g. Europe/London)
APP_TIMEZONE=UTC
# Where the app keeps its database. In Docker this is the /data mount.
DATA_DIR=./data
