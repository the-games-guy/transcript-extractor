# --- Claude (summaries) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for summaries
# ANTHROPIC_MODEL=claude-opus-5-5

# --- YouTube Data API v3 (keyword search + scheduled watches) ---
# Create a key at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" for the project.
YOUTUBE_API_KEY=

# --- Email delivery (SMTP) ---
# For Gmail, use smtp.gmail.com:587 with an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=you@gmail.com
# Comma-separated list of recipients
EMAIL_TO=you@gmail.com

# --- Storage ---
TRANSCRIPTS_DIR=transcripts
STATE_FILE=.state/processed.json
# Preferred transcript languages, in order
TRANSCRIPT_LANGUAGES=en
